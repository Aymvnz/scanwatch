# Optional. Without these, ScanWatch persists to backend/data/state.json (no setup needed).
# The service-role key stays on the server and is never exposed to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Comma-separated list of allowed browser origins
SCANWATCH_CORS=http://localhost:3000,http://127.0.0.1:3000
